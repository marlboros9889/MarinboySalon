<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.marinboy.serviceitem.dao.ServiceItemDao">

    <!-- ServiceItemDao.findActiveList: 고객에게 공개할 시술만 조회합니다. -->
    <select id="findActiveList" resultType="ServiceItemDto">
        SELECT id,
               name,
               price,
               duration_minutes,
               description,
               active
        FROM service_item
        WHERE active = 1
        ORDER BY price ASC, id ASC
    </select>

    <!-- ServiceItemDao.findById: 예약할 시술의 가격과 소요 시간을 확인합니다. -->
    <select id="findById" parameterType="long" resultType="ServiceItemDto">
        SELECT id,
               name,
               price,
               duration_minutes,
               description,
               active
        FROM service_item
        WHERE id = #{id}
    </select>
</mapper>

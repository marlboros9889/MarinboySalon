<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 기반 MyBatis 재설계 프로젝트의 부모 설정입니다. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <!-- 기존 marinboy 기능을 MyBatis 구조로 복원하는 새 프로젝트 식별자입니다. -->
    <groupId>com.marinboy</groupId>
    <artifactId>marinboy-v3</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>marinboy-v3</name>
    <description>Marinboy reservation service with MyBatis and JPA migration</description>

    <properties>
        <!-- track007_boot_api와 동일하게 Java 17을 기준으로 컴파일합니다. -->
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- 웹 화면과 REST API를 제공하기 위한 Spring MVC 의존성입니다. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 새 예약 알림을 관리자 이메일로 선택 발송합니다. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- 서비스 계정으로 원장님의 Google Calendar에 예약 일정을 등록합니다. -->
        <dependency>
            <groupId>com.google.apis</groupId>
            <artifactId>google-api-services-calendar</artifactId>
            <version>v3-rev20260708-2.0.0</version>
        </dependency>

        <!-- 서비스 계정 JSON 키를 Google API 인증 정보로 변환합니다. -->
        <dependency>
            <groupId>com.google.auth</groupId>
            <artifactId>google-auth-library-oauth2-http</artifactId>
            <version>1.50.0</version>
        </dependency>

        <!-- DAO 인터페이스와 mapper XML을 연결하기 위한 MyBatis Spring Boot 의존성입니다. -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- 요청 DTO의 필수값, 이메일, 숫자 범위 등을 검증하기 위한 의존성입니다. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Track boot1 수업의 Entity/Repository 계층을 병행 적용합니다. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Swagger UI로 v3 REST API 계약을 확인합니다. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>

        <!-- JWT 기반 로그인과 URL별 권한 제어를 담당하는 Spring Security 의존성입니다. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT 로그아웃 토큰을 Redis에 보관해 즉시 무효화합니다. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 로컬 Oracle XE 데이터베이스에 연결하기 위한 JDBC 드라이버입니다. -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.5.0.24.07</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 자동화된 검증 테스트를 작성하기 위한 Spring Boot 테스트 의존성입니다. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MyBatis mapper와 DAO가 테스트 환경에서도 정상 동작하는지 확인하기 위한 의존성입니다. -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter-test</artifactId>
            <version>3.0.3</version>
            <scope>test</scope>
        </dependency>

        <!-- Security 설정이 테스트 환경에서도 정상적으로 로딩되는지 검증하기 위한 의존성입니다. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- 로컬 비밀번호와 서비스 계정 키는 실행 JAR에 절대 포함하지 않습니다. -->
                <excludes>
                    <exclude>application-local.properties</exclude>
                    <exclude>**/*service-account*.json</exclude>
                    <exclude>**/*.p12</exclude>
                    <exclude>**/*.pem</exclude>
                    <exclude>**/*.key</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- Spring Boot 애플리케이션 실행과 패키징을 담당하는 기본 플러그인입니다. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

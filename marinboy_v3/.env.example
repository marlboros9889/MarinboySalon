# 이 파일을 .env.local로 복사한 뒤 실제 값만 입력합니다.
# .env.local은 Git과 실행 JAR에서 제외됩니다.

# 필수: Oracle 연결
ORACLE_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
ORACLE_USERNAME=marinboy
ORACLE_PASSWORD=change-me

# 선택: 실행 주소와 프로필
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8082
SSR_API_BASE_URL=http://127.0.0.1:8082
NEXT_PUBLIC_API_BASE_URL=
APP_FRONTEND_BASE_URL=http://127.0.0.1:3000
SOCIAL_LOGIN_CALLBACK_BASE_URL=http://127.0.0.1:3000
# 기존 properties 파일을 외부에서 사용할 때만 절대 경로를 지정합니다.
MARINBOY_CONFIG_FILE=

# 선택: 고정 업로드 저장소. 반드시 절대 경로를 입력합니다.
# 비워 두면 사용자 홈의 .marinboy/uploads를 사용합니다.
UPLOAD_DIRECTORY=
# 비워 두면 사용자 홈의 .marinboy/build/v3-backend를 사용합니다.
MARINBOY_BUILD_DIRECTORY=
# 실행 중인 JAR과 겹치지 않는 검증 전용 폴더입니다. 비워 두면 사용자 홈을 사용합니다.
MARINBOY_VERIFY_BUILD_DIRECTORY=
# OneDrive 잠금을 피하는 production Next 빌드 폴더이며 사용자 홈 아래 경로만 허용합니다.
MARINBOY_FRONTEND_BUILD_DIRECTORY=

# 선택: Google Calendar 서비스 계정
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
# 권장 위치: C:/Users/<사용자>/.marinboy/credentials/google-calendar-service-account.json
GOOGLE_CALENDAR_CREDENTIALS_PATH=

# 선택: 관리자 메일 알림
NOTIFICATION_MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 필수: v3 JWT/Redis 인증. JWT_SECRET은 32바이트 이상 값을 Base64로 인코딩합니다.
JWT_SECRET=replace-with-base64-encoded-32-byte-secret
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 선택: 카카오/네이버/Google 로그인. 등록한 Callback URL은 아래 주소와 정확히 같아야 합니다.
# http://127.0.0.1:3000/login/oauth2/code/kakao
# http://127.0.0.1:3000/login/oauth2/code/naver
# http://127.0.0.1:3000/login/oauth2/code/google
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 선택: Google Maps 브라우저 키
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

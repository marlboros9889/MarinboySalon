# v2 전용 Oracle 설정입니다. 실제 비밀번호가 든 .env.local은 Git에 올리지 않습니다.
V2_ORACLE_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
V2_ORACLE_USERNAME=marinboy
V2_ORACLE_PASSWORD=change-me

# v2는 세션 방식이며 Redis와 JWT 설정을 사용하지 않습니다.
V2_SERVER_PORT=8081
# 비워 두면 사용자 홈의 .marinboy/uploads를 사용합니다.
V2_UPLOAD_DIRECTORY=
# 비워 두면 사용자 홈의 .marinboy/build/v2를 사용합니다.
V2_BUILD_DIRECTORY=
# 실행 중인 JAR과 겹치지 않는 검증 전용 폴더입니다. 비워 두면 사용자 홈을 사용합니다.
V2_VERIFY_BUILD_DIRECTORY=

# 선택: Kakao 세션 로그인
KAKAO_CLIENT_ID=not-configured
KAKAO_CLIENT_SECRET=
